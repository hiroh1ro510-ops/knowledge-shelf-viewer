---
// 判断は画面ではなく Claude Code のヘッドレスツール（ks judge）で行う。
// ここではコピー用コマンドを表示するだけ。
export interface Props { itemId: string; title: string; }
const { itemId } = Astro.props;
const statuses = [
  { key: "knowledge", label: "ナレッジ",   color: "bg-blue-50 text-blue-700 border-blue-200" },
  { key: "skill",     label: "スキル候補", color: "bg-green-50 text-green-700 border-green-200" },
  { key: "neta",      label: "ネタ",       color: "bg-purple-50 text-purple-700 border-purple-200" },
  { key: "material",  label: "素材",       color: "bg-orange-50 text-orange-700 border-orange-200" },
  { key: "out",       label: "対象外",     color: "bg-gray-50 text-gray-500 border-gray-200" },
];
---
<div>
  <p class="text-xs font-semibold text-gray-400 mb-2">判断（Claude Code で実行）</p>
  <p class="text-[11px] text-gray-400 mb-3 leading-relaxed">クリックでコマンドをコピー。Claude Code に貼るか「ID {itemId} をナレッジにして」と伝える。</p>
  <div class="flex flex-col gap-1.5">
    {statuses.map(({ key, label, color }) => (
      <button type="button" data-cmd={`~/.claude/knowledge-shelf/ks judge ${itemId} ${key}`}
        class={`judge-copy flex items-center justify-between px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors hover:brightness-95 ${color}`}>
        <span>{label}</span><span class="opacity-60 font-mono">{key}</span>
      </button>
    ))}
  </div>
  <p id="judge-copied" class="text-[11px] text-green-600 mt-2 hidden">コピーしました</p>
</div>
<script is:inline>
  document.addEventListener("click", async (e) => {
    const b = e.target.closest(".judge-copy");
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.cmd); } catch {}
    const m = document.getElementById("judge-copied");
    if (m) { m.classList.remove("hidden"); setTimeout(() => m.classList.add("hidden"), 1500); }
  });
</script>
