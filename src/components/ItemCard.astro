---
export interface Props {
  item: any;
}
const { item } = Astro.props;
const d = item.data;

const typeIcon: Record<string, string> = {
  youtube: "🎬", vimeo: "🎥", pdf: "📄", web: "🌐", note: "✍️", memo: "📝",
};

const statusColor: Record<string, string> = {
  pending:   "bg-yellow-50 text-yellow-700 border-yellow-200",
  neta:      "bg-purple-50 text-purple-700 border-purple-200",
  knowledge: "bg-blue-50 text-blue-700 border-blue-200",
  skill:     "bg-green-50 text-green-700 border-green-200",
  material:  "bg-orange-50 text-orange-700 border-orange-200",
  out:       "bg-gray-50 text-gray-500 border-gray-200",
};

// タグ色ハッシュ（タグ名ベースで色を決定）
function tagColor(tag: string): string {
  const palette = [
    "bg-blue-50 text-blue-700",
    "bg-green-50 text-green-700",
    "bg-purple-50 text-purple-700",
    "bg-orange-50 text-orange-700",
    "bg-red-50 text-red-700",
    "bg-teal-50 text-teal-700",
  ];
  let h = 0;
  for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) & 0xffff;
  return palette[h % palette.length];
}

const dateStr = d.created_at ? d.created_at.slice(0, 10) : "";
const thumb = d.screenshots && d.screenshots.length > 0 ? d.screenshots[0] : null;
const searchText = [d.title, d.one_line, ...(d.suggested_tags ?? [])].join(" ");
---

<a
  href={`/items/${item.id}`}
  class="group flex flex-col bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow duration-200"
  data-searchable={searchText}
  data-tags={JSON.stringify(d.suggested_tags ?? [])}
>
  <!-- サムネイル -->
  <div class="relative w-full bg-gray-50 flex items-center justify-center overflow-hidden" style="aspect-ratio: 16/9;">
    {thumb ? (
      <img
        src={thumb}
        alt={d.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    ) : (
      <span class="text-5xl select-none opacity-60">{typeIcon[d.source_type] ?? "📎"}</span>
    )}
    <!-- ステータスバッジ（右上） -->
    <span class={`absolute top-2 right-2 text-xs px-2 py-0.5 rounded-full border font-medium ${statusColor[d.status] ?? statusColor.pending}`}>
      {d.status}
    </span>
  </div>

  <!-- コンテンツ -->
  <div class="flex flex-col flex-1 p-4 gap-2">
    <!-- タイトル + 日付 -->
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-gray-900 text-sm leading-snug line-clamp-2 group-hover:text-blue-600 transition-colors">
        {d.title}
      </h3>
    </div>
    <p class="text-xs text-gray-400">{dateStr}</p>

    <!-- one_line -->
    <p class="text-xs text-gray-500 line-clamp-2 flex-1">{d.one_line}</p>

    <!-- タグ -->
    {d.suggested_tags && d.suggested_tags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-1">
        {d.suggested_tags.slice(0, 4).map((tag: string) => (
          <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${tagColor(tag)}`}>{tag}</span>
        ))}
        {d.suggested_tags.length > 4 && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-gray-50 text-gray-400">+{d.suggested_tags.length - 4}</span>
        )}
      </div>
    )}
  </div>
</a>
