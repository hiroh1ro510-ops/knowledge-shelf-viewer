---
export interface Props {
  active: "shelf" | "research" | "skills";
}
const { active } = Astro.props;
const tabs = [
  { id: "shelf",    label: "📚 本棚",    href: "/" },
  { id: "research", label: "🔍 リサーチ", href: "/research" },
  { id: "skills",   label: "⭐ スキル",  href: "/skills" },
];
---
<nav class="flex border-b border-gray-200 mb-6 gap-1">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      class={`px-5 py-2.5 text-sm font-medium border-b-2 transition-colors ${
        active === tab.id
          ? "border-blue-600 text-blue-600"
          : "border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300"
      }`}
    >
      {tab.label}
    </a>
  ))}
</nav>
