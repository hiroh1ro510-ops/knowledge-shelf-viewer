---
export interface Props {
  itemId: string;
  title: string;
  repoOwner?: string;
  knowledgeRepo?: string;
}
const {
  itemId,
  title,
  repoOwner = "YOUR_GITHUB_USERNAME",
  knowledgeRepo = "my-knowledge-base",
} = Astro.props;

const encTitle = encodeURIComponent(title);
const encId = encodeURIComponent(itemId);
const labels = [
  { key: "neta",      label: "ネタ",     color: "border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100" },
  { key: "knowledge", label: "ナレッジ", color: "border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100" },
  { key: "skill",     label: "スキル候補", color: "border-green-200 bg-green-50 text-green-700 hover:bg-green-100" },
  { key: "material",  label: "素材",     color: "border-orange-200 bg-orange-50 text-orange-700 hover:bg-orange-100" },
  { key: "out",       label: "対象外",   color: "border-gray-200 bg-gray-50 text-gray-500 hover:bg-gray-100" },
];
---
<div>
  <p class="text-xs font-semibold text-gray-400 mb-3">判断</p>
  <div class="flex flex-col gap-2">
    {labels.map(({ key, label, color }) => {
      const url = `https://github.com/${repoOwner}/${knowledgeRepo}/issues/new?template=knowledge.yml&title=${encTitle}&body=item_id%3A+${encId}%0Astatus%3A+${key}`;
      return (
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class={`flex items-center justify-center px-3 py-2 rounded-lg text-sm font-medium border transition-colors ${color}`}
        >
          {label}
        </a>
      );
    })}
  </div>
</div>
